#!/bin/bash
#PBS -N pgc-v1-e5
#PBS -q large_gpuq
#PBS -l select=1:ngpus=1:ncpus=4:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export HF_HOME="$HOME/.cache/huggingface"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false

GATE_C_GPU_INDEX="$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits | sort -t, -k2,2n | head -1 | cut -d, -f1 | tr -d " ")"
if ! [[ "$GATE_C_GPU_INDEX" =~ ^[0-9]+$ ]]; then
  echo "Could not select one GPU index: $GATE_C_GPU_INDEX"
  exit 1
fi
export CUDA_VISIBLE_DEVICES="$GATE_C_GPU_INDEX"
echo "Selected physical GPU index: $GATE_C_GPU_INDEX"
nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv,noheader

PYTHONPATH=src:. python scripts/embed_gate_c_prefixes.py \
  --config configs/gate_c_development_v1.yaml

