#!/bin/bash
#PBS -N olmo-qc-merge
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=12gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONUNBUFFERED=1

CONFIG="configs/cross_model_replication_olmo_qc_v1.yaml"
ROOT="outputs/cross_model_replication/olmo_qc_v1"
PYTHONPATH=src:. python scripts/merge_partitioned_gate_a_shards.py \
  --config "$CONFIG"
PYTHONPATH=src:. python scripts/analyze_olmo_formal_generation_qc.py \
  --config "$CONFIG" \
  --output "$ROOT/formal_generation_qc.json"

for reviewer in measurement_a measurement_b measurement_c; do
  case "$reviewer" in
    measurement_a) shuffle_seed=20261101 ;;
    measurement_b) shuffle_seed=20261102 ;;
    measurement_c) shuffle_seed=20261103 ;;
  esac
  PYTHONPATH=src:. python scripts/create_extraction_review_sheet.py \
    --manifest "$ROOT/probes.jsonl" \
    --template data/templates/persona_cross_model_olmo_prompt_minimal_v1.yaml \
    --reviewer-id "$reviewer" \
    --shuffle-seed "$shuffle_seed" \
    --output "$ROOT/review/$reviewer.csv"
done
