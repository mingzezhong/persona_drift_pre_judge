#!/bin/bash
#PBS -N pgc-dc-out
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=12gb
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONUNBUFFERED=1

ROOT="outputs/gate_c/dissociation_confirmation/qwen_v1"
PYTHONPATH=src python scripts/merge_extraction_reviews.py \
  --config configs/ai_judges_dissociation_confirmation_qwen_v1.yaml \
  --resume
set +e
PYTHONPATH=src python scripts/analyze_gate_a.py \
  --config configs/dissociation_confirmation_qwen_v1.yaml \
  --reviewed-manifest "$ROOT/ai_review/reviewed_probes.jsonl"
ANALYSIS_EXIT="$?"
set -e
if [[ "$ANALYSIS_EXIT" -ne 0 && "$ANALYSIS_EXIT" -ne 2 ]]; then
  exit "$ANALYSIS_EXIT"
fi
printf '{"analyze_gate_a_exit_code": %s, "gate_pass": %s}\n' \
  "$ANALYSIS_EXIT" "$([[ "$ANALYSIS_EXIT" -eq 0 ]] && echo true || echo false)" \
  > "$ROOT/analysis/gate_status.json"
echo "Gate A analysis exit code: $ANALYSIS_EXIT; continuing to frozen forecast analysis."

