#!/bin/bash
#PBS -N pcm-olmo-cau
#PBS -q large_gpuq
#PBS -l select=1:ngpus=1:ncpus=4:mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export HF_HOME="$HOME/.cache/huggingface"
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false

GPU_INDEX="$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits | sort -t, -k2,2n | head -1 | cut -d, -f1 | tr -d " ")"
if ! [[ "$GPU_INDEX" =~ ^[0-9]+$ ]]; then
  echo "Could not select one GPU index: $GPU_INDEX"
  exit 1
fi
export CUDA_VISIBLE_DEVICES="$GPU_INDEX"
echo "Selected physical GPU index: $GPU_INDEX"

PYTHONPATH=src python scripts/check_hardware.py \
  --config configs/cross_model_replication_olmo_v1.yaml
PYTHONPATH=src python scripts/generate_gate_a_trajectories.py \
  --config configs/cross_model_replication_olmo_v1.yaml \
  --axis cautious_risk_seeking \
  --output-dir outputs/cross_model_replication/olmo_v1/shards/cautious_risk_seeking
