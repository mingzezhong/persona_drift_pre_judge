#!/bin/bash
#PBS -N pga-p1-merge
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail

PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONUNBUFFERED=1

PYTHONPATH=src python scripts/merge_gate_a_shards.py \
  --config configs/gate_a_pilot_v1.yaml
PYTHONPATH=src:. python scripts/create_extraction_review_sheet.py \
  --manifest outputs/gate_a/pilot_v1/probes.jsonl \
  --template data/templates/persona_gate_a_pilot_v1.yaml \
  --reviewer-id reviewer_a \
  --shuffle-seed 20260911 \
  --output outputs/gate_a/pilot_v1/review/reviewer_a.csv
PYTHONPATH=src:. python scripts/create_extraction_review_sheet.py \
  --manifest outputs/gate_a/pilot_v1/probes.jsonl \
  --template data/templates/persona_gate_a_pilot_v1.yaml \
  --reviewer-id reviewer_b \
  --shuffle-seed 20260912 \
  --output outputs/gate_a/pilot_v1/review/reviewer_b.csv
