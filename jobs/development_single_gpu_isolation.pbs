#!/bin/bash
#PBS -N dev-1g-probe
#PBS -q med_gpuq
#PBS -l select=1:ncpus=2:ngpus=1:mem=8gb
#PBS -l walltime=00:10:00
#PBS -j oe

set -euo pipefail
umask 027

PROJECT_ROOT="${PBS_O_WORKDIR:?PBS_O_WORKDIR is required}"
PYTHON_BIN="/shared/homes/u24524629/miniconda3/envs/persona-drift/bin/python"
REPORT_DIR="$PROJECT_ROOT/outputs/development/single_gpu_isolation"

cd "$PROJECT_ROOT"
mkdir -p "$REPORT_DIR"
export PYTHONDONTWRITEBYTECODE=1
export G1_ISOLATION_REPORT="$REPORT_DIR/${PBS_JOBID}.json"

echo "job_id=${PBS_JOBID:-unknown}"
echo "host=$(hostname)"
echo "cuda_visible_devices=${CUDA_VISIBLE_DEVICES:-unset}"
echo "pbs_gpufile=${PBS_GPUFILE:-unset}"
if [[ -n "${PBS_GPUFILE:-}" && -r "$PBS_GPUFILE" ]]; then
  sed 's/^/pbs_gpufile_entry=/' "$PBS_GPUFILE"
fi

"$PYTHON_BIN" - <<'PY'
import json
import os
from pathlib import Path

import torch

visible = os.environ.get("CUDA_VISIBLE_DEVICES", "").strip()
visible_entries = [entry.strip() for entry in visible.split(",") if entry.strip()]
payload = {
    "schema_version": "development-single-gpu-isolation-v1",
    "job_id": os.environ.get("PBS_JOBID", "unknown"),
    "host": os.uname().nodename,
    "cuda_visible_devices": visible or None,
    "visible_device_entries": visible_entries,
    "torch_cuda_available": torch.cuda.is_available(),
    "torch_cuda_device_count": torch.cuda.device_count(),
}

if visible and len(visible_entries) != 1:
    raise SystemExit(
        "single-GPU isolation failed: scheduler exposed more than one "
        "CUDA_VISIBLE_DEVICES entry"
    )
if not torch.cuda.is_available() or torch.cuda.device_count() != 1:
    raise SystemExit(
        "single-GPU isolation failed: PyTorch does not see exactly one GPU"
    )

probe = torch.ones((256, 256), dtype=torch.float16, device="cuda:0")
observed = float((probe @ probe).mean().item())
torch.cuda.synchronize(0)
if observed != 256.0:
    raise SystemExit(f"single-GPU fp16 probe returned {observed}, expected 256.0")

payload.update(
    {
        "gpu_name": torch.cuda.get_device_name(0),
        "fp16_probe_mean": observed,
        "passed": True,
    }
)
report_path = Path(os.environ["G1_ISOLATION_REPORT"])
report_path.write_text(
    json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
print(json.dumps(payload, ensure_ascii=False, sort_keys=True))
PY
