#!/bin/bash
#PBS -N olmo-len-merge
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=12gb
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONUNBUFFERED=1

ROOT="outputs/cross_model_replication/olmo_length_pilot_v1"
set +e
PYTHONPATH=src python scripts/merge_partitioned_gate_a_shards.py \
  --config configs/cross_model_length_pilot_olmo_v1_cap256.yaml
CAP256_RC=$?
PYTHONPATH=src python scripts/merge_partitioned_gate_a_shards.py \
  --config configs/cross_model_length_pilot_olmo_v1_cap384.yaml
CAP384_RC=$?
set -e
for rc in "$CAP256_RC" "$CAP384_RC"; do
  if [[ "$rc" -ne 0 && "$rc" -ne 2 ]]; then
    echo "Unexpected merge failure: $rc" >&2
    exit "$rc"
  fi
done
PYTHONPATH=src:. python scripts/analyze_generation_length_pilot.py \
  --configs \
    configs/cross_model_length_pilot_olmo_v1_cap256.yaml \
    configs/cross_model_length_pilot_olmo_v1_cap384.yaml \
  --output "$ROOT/summary.json"
