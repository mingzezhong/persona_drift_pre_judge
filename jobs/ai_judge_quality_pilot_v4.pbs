#!/bin/bash
#PBS -N persona-ai-judge-v4
#PBS -q large_gpuq
#PBS -l select=1:ngpus=2:ncpus=8:mem=64gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail

PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift

export HF_HOME="$HOME/.cache/huggingface"
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export CUDA_DEVICE_ORDER=PCI_BUS_ID

CUDA_VISIBLE_DEVICES=0 PYTHONPATH=src \
  python scripts/judge_extraction.py \
    --config configs/ai_judges_v4.yaml \
    --judge-id judge_a \
    --resume &
JUDGE_A_PID=$!

CUDA_VISIBLE_DEVICES=1 PYTHONPATH=src \
  python scripts/judge_extraction.py \
    --config configs/ai_judges_v4.yaml \
    --judge-id judge_b \
    --resume &
JUDGE_B_PID=$!

STATUS=0
wait "$JUDGE_A_PID" || STATUS=1
wait "$JUDGE_B_PID" || STATUS=1
if [ "$STATUS" -ne 0 ]; then
  echo "At least one AI judge failed; consensus was not computed."
  exit "$STATUS"
fi

PYTHONPATH=src python scripts/merge_extraction_reviews.py \
  --config configs/ai_judges_v4.yaml \
  --resume
PYTHONPATH=src python scripts/check_pair_quality_gate.py \
  --manifest outputs/extraction/quality_pilot_s0_v4/ai_review/reviewed_manifest.jsonl \
  --rubric configs/extraction_judge_rubric_v2.yaml \
  --output outputs/extraction/quality_pilot_s0_v4/ai_review/pair_quality.json \
  --resume
