#!/bin/bash
#PBS -N olmo-ps-test
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=12gb
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1

sha256sum -c docs/olmo_prompt_salience_smoke_v1_protocol_files.sha256
PYTHONPATH=src:. python -m py_compile \
  scripts/create_prompt_salience_templates.py \
  scripts/analyze_prompt_salience_smoke.py \
  scripts/validate_prompt_salience_smoke.py \
  tests/test_prompt_salience_templates.py \
  tests/test_analyze_prompt_salience_smoke.py
PYTHONPATH=src:. python -m pytest \
  tests/test_prompt_salience_templates.py \
  tests/test_analyze_prompt_salience_smoke.py \
  tests/test_repetition_control.py \
  tests/test_analyze_repetition_control_smoke.py \
  -p no:cacheprovider
PYTHONPATH=src:. python scripts/validate_prompt_salience_smoke.py \
  --configs \
    configs/olmo_prompt_salience_smoke_minimal.yaml \
    configs/olmo_prompt_salience_smoke_strict3.yaml
