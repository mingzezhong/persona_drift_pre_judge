#!/bin/bash
#PBS -N pcm-olmo-merge
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=12gb
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONUNBUFFERED=1

ROOT="outputs/cross_model_replication/olmo_v1"
PYTHONPATH=src python scripts/merge_partitioned_gate_a_shards.py \
  --config configs/cross_model_replication_olmo_v1.yaml
PYTHONPATH=src:. python scripts/create_extraction_review_sheet.py \
  --manifest "$ROOT/probes.jsonl" \
  --template data/templates/persona_cross_model_olmo_v1.yaml \
  --reviewer-id measurement_a \
  --shuffle-seed 20261101 \
  --output "$ROOT/review/measurement_a.csv"
PYTHONPATH=src:. python scripts/create_extraction_review_sheet.py \
  --manifest "$ROOT/probes.jsonl" \
  --template data/templates/persona_cross_model_olmo_v1.yaml \
  --reviewer-id measurement_b \
  --shuffle-seed 20261102 \
  --output "$ROOT/review/measurement_b.csv"
PYTHONPATH=src:. python scripts/create_extraction_review_sheet.py \
  --manifest "$ROOT/probes.jsonl" \
  --template data/templates/persona_cross_model_olmo_v1.yaml \
  --reviewer-id measurement_c \
  --shuffle-seed 20261103 \
  --output "$ROOT/review/measurement_c.csv"
