#!/bin/bash
#PBS -N pga-p1-ana
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONUNBUFFERED=1

PYTHONPATH=src python scripts/merge_extraction_reviews.py \
  --config configs/ai_judges_gate_a_pilot_v1.yaml \
  --resume
set +e
PYTHONPATH=src python scripts/analyze_gate_a.py \
  --config configs/gate_a_pilot_v1.yaml \
  --reviewed-manifest outputs/gate_a/pilot_v1/ai_review/reviewed_probes.jsonl
ANALYSIS_EXIT="$?"
set -e
if [[ "$ANALYSIS_EXIT" -ne 0 && "$ANALYSIS_EXIT" -ne 2 ]]; then
  exit "$ANALYSIS_EXIT"
fi
PYTHONPATH=src:. python scripts/analyze_gate_a_judge_reliability.py \
  --config configs/gate_a_pilot_v1.yaml \
  --checkpoint-scores outputs/gate_a/pilot_v1/analysis/checkpoint_scores.csv \
  --output outputs/gate_a/pilot_v1/analysis/judge_reliability.json

exit "$ANALYSIS_EXIT"
