#!/bin/bash
#PBS -N pcm-olmo-test
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=12gb
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1

PYTHONPATH=src:. python -m pytest tests -p no:cacheprovider
PYTHONPATH=src:. python scripts/validate_cross_model_replication.py \
  --config configs/cross_model_replication_olmo_v1.yaml

