#!/bin/bash
#PBS -N pgc-dis-prep
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${PBS_NCPUS:-4}"

PYTHONPATH=src:. python scripts/power_dissociation_confirmation.py \
  --predictions outputs/gate_c/development_v2/analysis/primary_predictions.csv \
  --v2-summary outputs/gate_c/development_v2/analysis/summary.json \
  --output docs/gate_c_dissociation_confirmation_v1_power.json \
  --samples 5000 \
  --seed 20260920

PYTHONPATH=src:. python scripts/freeze_dissociation_predictor.py \
  --config configs/gate_c_development_v2.yaml \
  --output-dir outputs/gate_c/frozen_predictors/dissociation_v1
