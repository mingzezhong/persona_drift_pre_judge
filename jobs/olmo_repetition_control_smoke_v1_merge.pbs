#!/bin/bash
#PBS -N olmo-rp-merge
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=12gb
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONUNBUFFERED=1

ROOT="outputs/cross_model_replication/olmo_repetition_control_smoke_v1"
set +e
for candidate in rp105 rp110; do
  PYTHONPATH=src:. python scripts/merge_partitioned_gate_a_shards.py \
    --config "configs/olmo_repetition_smoke_${candidate}.yaml"
  rc=$?
  if [[ "$rc" -ne 0 && "$rc" -ne 2 ]]; then
    echo "Unexpected merge failure for $candidate: $rc" >&2
    exit "$rc"
  fi
done
set -e
PYTHONPATH=src:. python scripts/analyze_repetition_control_smoke.py \
  --configs \
    configs/olmo_repetition_smoke_rp105.yaml \
    configs/olmo_repetition_smoke_rp110.yaml \
  --output "$ROOT/summary.json"
