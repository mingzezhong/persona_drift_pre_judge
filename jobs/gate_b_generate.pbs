#!/bin/bash
#PBS -N persona-gate-b-gen
#PBS -q large_gpuq
#PBS -l select=1:ngpus=1:ncpus=4:mem=32gb
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail

PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
OUTPUT_DIR="outputs/gate_b/representation_pilot_v1"
cd "$PROJECT_DIR"

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift

export HF_HOME="$HOME/.cache/huggingface"
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false

GATE_B_GPU_INDEX="$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits | sort -t, -k2,2n | head -1 | cut -d, -f1 | tr -d " ")"
if ! [[ "$GATE_B_GPU_INDEX" =~ ^[0-9]+$ ]]; then
  echo "Could not select one GPU index: $GATE_B_GPU_INDEX"
  exit 1
fi
export CUDA_VISIBLE_DEVICES="$GATE_B_GPU_INDEX"
echo "Selected physical GPU index: $GATE_B_GPU_INDEX"

PYTHONPATH=src python scripts/check_hardware.py --config configs/gate_b_generation.yaml
PYTHONPATH=src python scripts/generate_extraction_data.py \
  --template data/templates/persona_gate_b.yaml \
  --config configs/gate_b_generation.yaml \
  --output-dir "$OUTPUT_DIR" \
  --seeds 1 2
PYTHONPATH=src python scripts/validate_extraction_run.py \
  --manifest "$OUTPUT_DIR/manifest.jsonl"
PYTHONPATH=src python scripts/check_generation_quality_gate.py \
  --manifest "$OUTPUT_DIR/manifest.jsonl" \
  --rubric configs/extraction_judge_rubric_v2.yaml \
  --output "$OUTPUT_DIR/generation_quality.json" \
  --fail-on-gate
PYTHONPATH=src:. python scripts/create_extraction_review_sheet.py \
  --manifest "$OUTPUT_DIR/manifest.jsonl" \
  --template data/templates/persona_gate_b.yaml \
  --reviewer-id reviewer_a \
  --shuffle-seed 20260813 \
  --output "$OUTPUT_DIR/review/reviewer_a.csv"
PYTHONPATH=src:. python scripts/create_extraction_review_sheet.py \
  --manifest "$OUTPUT_DIR/manifest.jsonl" \
  --template data/templates/persona_gate_b.yaml \
  --reviewer-id reviewer_b \
  --shuffle-seed 20260814 \
  --output "$OUTPUT_DIR/review/reviewer_b.csv"
