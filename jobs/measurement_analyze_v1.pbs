#!/bin/bash
#PBS -N pmd-v1-ana
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1

set +e
PYTHONPATH=src:. python scripts/analyze_measurement_development.py \
  --config configs/persona_measurement_development_v1.yaml \
  --judges-config configs/ai_judges_measurement_development_v1.yaml
ANALYSIS_EXIT="$?"
set -e
if [[ "$ANALYSIS_EXIT" -ne 0 && "$ANALYSIS_EXIT" -ne 2 ]]; then
  exit "$ANALYSIS_EXIT"
fi
echo "Measurement validation exit code: $ANALYSIS_EXIT"
exit 0

