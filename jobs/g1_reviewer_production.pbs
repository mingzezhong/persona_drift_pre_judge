#!/bin/bash
#PBS -N g1-review-production
#PBS -q med_gpuq
#PBS -l select=1:ncpus=6:ngpus=2:mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail
umask 027

PROJECT_ROOT="${PBS_O_WORKDIR:?PBS_O_WORKDIR is required}"
REVIEWER_SLOT="${REVIEWER_SLOT:?submit with REVIEWER_SLOT=<primary_01|primary_02|primary_03>}"
TASK_ID="${TASK_ID:?submit with TASK_ID=<persona_scalar|topic_triage>}"
PYTHON_BIN="/shared/homes/u24524629/miniconda3/envs/persona-drift/bin/python"
REGISTRY_PATH="configs/g1_reviewer_registry_production_v2_3.yaml"
PROMPTS_PATH="data/rater_specs/g1_local_reviewer_prompts_v2_3.yaml"

cd "$PROJECT_ROOT"
case "$REVIEWER_SLOT:$TASK_ID" in
  primary_01:persona_scalar|primary_02:persona_scalar|primary_03:persona_scalar)
    PACKET_PATH="data/stages/persona_scalar_${REVIEWER_SLOT}_input_v2_3.jsonl"
    OUTPUT_PATH="outputs/g1/reviews/persona_scalar_${REVIEWER_SLOT}_v2_3.jsonl"
    ;;
  primary_01:topic_triage|primary_02:topic_triage)
    PACKET_PATH="data/reviews/topic_mmlu_triage_input_v2_3.jsonl"
    OUTPUT_PATH="outputs/g1/reviews/topic_mmlu_triage_${REVIEWER_SLOT}_v2_3.jsonl"
    ;;
  *)
    echo "unsupported production assignment: $REVIEWER_SLOT:$TASK_ID" >&2
    exit 2
    ;;
esac

test -s "$REGISTRY_PATH"
test -s "$PROMPTS_PATH"
test -s "$PACKET_PATH"
mkdir -p "$(dirname -- "$OUTPUT_PATH")"

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$PROJECT_ROOT/src"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

echo "job_id=${PBS_JOBID:-unknown}"
echo "host=$(hostname)"
echo "project_root=$PROJECT_ROOT"
echo "reviewer_slot=$REVIEWER_SLOT"
echo "task_id=$TASK_ID"
echo "packet_path=$PACKET_PATH"
echo "output_path=$OUTPUT_PATH"
echo "output_mode=append_or_resume"
nvidia-smi --query-gpu=name,uuid,memory.total,driver_version --format=csv,noheader
"$PYTHON_BIN" - <<'PY'
import json
import torch

gpu_count = torch.cuda.device_count()
print(json.dumps({"cuda_available": torch.cuda.is_available(), "gpu_count": gpu_count}))
if not torch.cuda.is_available() or gpu_count != 2:
    raise SystemExit("production reviewer requires both allocated GPUs to be visible")
PY

"$PYTHON_BIN" scripts/run_g1_local_reviewer.py \
  --production \
  --slot "$REVIEWER_SLOT" \
  --task "$TASK_ID" \
  --registry "$REGISTRY_PATH" \
  --prompts "$PROMPTS_PATH" \
  --packet "$PACKET_PATH" \
  --output "$OUTPUT_PATH" \
  --batch-size 1
