#!/bin/bash
#PBS -N olmo-psp-part
#PBS -q large_gpuq
#PBS -l select=1:ngpus=1:ncpus=4:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export HF_HOME="$HOME/.cache/huggingface"
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false

GPU_INDEX=""
while IFS=, read -r candidate_index candidate_memory; do
  candidate_index="${candidate_index//[[:space:]]/}"
  exec 9>"/tmp/persona-drift-${USER}-gpu-${candidate_index}.lock"
  if flock -n 9; then
    GPU_INDEX="$candidate_index"
    break
  fi
done < <(
  nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits |
    sort -t, -k2,2n
)
if ! [[ "$GPU_INDEX" =~ ^[0-9]+$ ]]; then
  echo "Could not acquire one node-local GPU lock."
  exit 1
fi
export CUDA_VISIBLE_DEVICES="$GPU_INDEX"

: "${AXIS:?AXIS must be supplied with qsub -v}"
: "${TOPIC:?TOPIC must be supplied with qsub -v}"
echo "Prompt-salience full pilot axis=$AXIS topic=$TOPIC physical_gpu=$GPU_INDEX"
PYTHONPATH=src python scripts/check_hardware.py \
  --config configs/olmo_prompt_salience_pilot_v1.yaml
PYTHONPATH=src:. python scripts/generate_repetition_control_smoke.py \
  --config configs/olmo_prompt_salience_pilot_v1.yaml \
  --axis "$AXIS" \
  --topic "$TOPIC" \
  --output-dir "outputs/cross_model_replication/olmo_prompt_salience_pilot_v1/shards_v2/$AXIS/$TOPIC"
