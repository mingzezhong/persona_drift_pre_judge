set -euo pipefail

PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift

export PYTHONUNBUFFERED=1

PYTHONPATH=src python scripts/analyze_behavior_correlation.py \
  --config configs/gate_b_behavior_v1.yaml
