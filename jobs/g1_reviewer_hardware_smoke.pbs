#!/bin/bash
#PBS -N g1-review-hw-smoke
#PBS -q small_gpuq
#PBS -l select=1:ncpus=4:ngpus=2:mem=32gb
#PBS -l walltime=00:15:00
#PBS -j oe

set -euo pipefail

PROJECT_ROOT="${PBS_O_WORKDIR:?PBS_O_WORKDIR is required}"
PYTHON_BIN="/shared/homes/u24524629/miniconda3/envs/persona-drift/bin/python"
ASSIGNED_NGPUS=2

cd "$PROJECT_ROOT"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONDONTWRITEBYTECODE=1

echo "job_id=${PBS_JOBID:-unknown}"
echo "host=$(hostname)"
SOURCE_COMMIT="${G1_SOURCE_COMMIT:-}"
if [[ -z "$SOURCE_COMMIT" ]] && command -v git >/dev/null 2>&1; then
  SOURCE_COMMIT="$(git -C "$PROJECT_ROOT" rev-parse HEAD 2>/dev/null || true)"
fi
SOURCE_COMMIT="${SOURCE_COMMIT:-unavailable}"
echo "commit=$SOURCE_COMMIT"
echo "scheduler_assigned_ngpus=$ASSIGNED_NGPUS"
echo "cuda_visible_devices=${CUDA_VISIBLE_DEVICES:-scheduler-default}"
echo "pbs_gpufile=${PBS_GPUFILE:-unavailable}"
if [[ -n "${PBS_GPUFILE:-}" && -r "$PBS_GPUFILE" ]]; then
  sed 's/^/pbs_gpufile_entry=/' "$PBS_GPUFILE"
fi
nvidia-smi --query-gpu=name,uuid,memory.total,driver_version --format=csv,noheader
export G1_ASSIGNED_NGPUS="$ASSIGNED_NGPUS"
"$PYTHON_BIN" - <<'PY'
import json
import os
import platform

import torch
import transformers

assigned_gpu_count = int(os.environ["G1_ASSIGNED_NGPUS"])
if assigned_gpu_count < 1:
    raise SystemExit("hardware smoke requires a positive scheduler GPU allocation")

payload = {
    "python": platform.python_version(),
    "torch": torch.__version__,
    "transformers": transformers.__version__,
    "cuda_available": torch.cuda.is_available(),
    "cuda_version": torch.version.cuda,
    "cuda_visible_devices": os.environ.get("CUDA_VISIBLE_DEVICES"),
    "scheduler_assigned_gpu_count": assigned_gpu_count,
    "gpu_count": torch.cuda.device_count(),
    "gpu_names": [torch.cuda.get_device_name(i) for i in range(torch.cuda.device_count())],
    "bf16_supported": bool(torch.cuda.is_bf16_supported()),
    "required_model_dtype": "float16",
}
if not payload["cuda_available"] or payload["gpu_count"] != assigned_gpu_count:
    print(json.dumps(payload, sort_keys=True))
    raise SystemExit(
        "hardware smoke CUDA visibility differs from the PBS allocation"
    )

# PBS does not isolate a one-GPU request from the node's second GPU on this cluster.
# Reserve both physical GPUs and execute an fp16 operation on each allocated device.
payload["float16_probe_devices"] = []
for device_index in range(assigned_gpu_count):
    probe = torch.ones(8, dtype=torch.float16, device=f"cuda:{device_index}")
    observed = (probe * 2).sum().item()
    torch.cuda.synchronize(device_index)
    if observed != 16:
        raise SystemExit(
            f"float16 CUDA probe returned an unexpected value on {device_index}"
        )
    payload["float16_probe_devices"].append(device_index)
print(json.dumps(payload, sort_keys=True))
PY
