#!/bin/bash
#PBS -N olmo-psp-test
#PBS -q smallq
#PBS -l select=1:ncpus=4:mem=12gb
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /shared/homes/u24524629/persona_drift_pre_judge/logs/

set -euo pipefail
PROJECT_DIR="${PBS_O_WORKDIR:-/shared/homes/u24524629/persona_drift_pre_judge}"
cd "$PROJECT_DIR"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate persona-drift
export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1

sha256sum -c docs/olmo_prompt_salience_pilot_v1_protocol_files.sha256
PYTHONPATH=src:. python -m py_compile \
  scripts/analyze_prompt_salience_pilot.py \
  scripts/validate_prompt_salience_pilot.py \
  tests/test_analyze_prompt_salience_pilot.py \
  tests/test_prompt_salience_pilot_design.py
PYTHONPATH=src:. python -m pytest -p no:cacheprovider \
  tests/test_analyze_prompt_salience_pilot.py \
  tests/test_prompt_salience_pilot_design.py \
  tests/test_prompt_salience_templates.py \
  tests/test_repetition_control.py \
  tests/test_analyze_repetition_control_smoke.py
PYTHONPATH=src:. python scripts/validate_prompt_salience_pilot.py \
  --config configs/olmo_prompt_salience_pilot_v1.yaml
